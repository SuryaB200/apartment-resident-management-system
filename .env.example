# ============================================================================
# APARTMENT & RESIDENT MANAGEMENT SYSTEM
# Environment Variables Configuration Template
# ============================================================================

# Django Secret Key & Debug Mode
DJANGO_SECRET_KEY=django-insecure-capstone-srm-tiruchirappalli-2024-dbms-secret-key-placeholder
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite WAL mode with foreign keys enabled)
# For PostgreSQL / MySQL, set DB_ENGINE and credentials:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=apartment_management_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
